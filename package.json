{
  "name": "qwikora",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --project tsconfig.scripts.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "astro build",
    "build:preview": "node --env-file=./policy/env/preview.env --run build",
    "build:production": "node --env-file=./policy/env/production.env --run build",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "ci": "npm run verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "astro": "6.4.8",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "parse5": "8.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  },
  "overrides": {
    "vite": "^7.0.0"
  }
}
